{
  "name": "myelin",
  "version": "1.0.0",
  "description": "A localhost tutor with a teaching memory: it researches a subject, writes an Obsidian-compatible vault of pages, and grades your work against them.",
  "repository": {
    "type": "git",
    "url": "https://github.com/SabienNguyen/loreweaver-harness.git"
  },
  "main": "electron/main.mjs",
  "scripts": {
    "test": "vitest",
    "typecheck": "tsc --noEmit",
    "dev:server": "tsx src/server/index.ts",
    "dev:client": "vite",
    "build": "vite build",
    "start": "tsx src/server/index.ts",
    "e2e": "playwright test",
    "build:server": "tsc -p tsconfig.server.json && node scripts/copy-server-assets.mjs",
    "build:all": "npm run build && npm run build:server",
    "bundle:engram": "node scripts/bundle-engram.mjs",
    "desktop": "npm run build:all && electron electron/main.mjs",
    "dist": "npm run build:all && npm run bundle:engram && electron-builder"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "type": "module",
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.12",
    "@ai-sdk/mcp": "^2.0.10",
    "@ai-sdk/openai-compatible": "^3.0.7",
    "@ai-sdk/react": "^4.0.23",
    "@anthropic-ai/claude-agent-sdk": "^0.3.216",
    "@assistant-ui/react": "^0.14.26",
    "@assistant-ui/react-ai-sdk": "^1.3.40",
    "@assistant-ui/react-markdown": "^0.14.5",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/language": "^6.12.4",
    "@codemirror/state": "^6.7.1",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.43.6",
    "@fontsource-variable/fraunces": "^5.2.9",
    "@fontsource-variable/newsreader": "^5.2.10",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@hono/node-server": "^2.0.8",
    "@phosphor-icons/react": "^2.1.10",
    "ai": "^7.0.22",
    "codemirror": "^6.0.2",
    "d3-drag": "^3.0.0",
    "d3-force": "^3.0.0",
    "d3-selection": "^3.0.0",
    "d3-zoom": "^3.0.0",
    "harper.js": "^2.4.0",
    "hono": "^4.12.29",
    "html-to-text": "^10.0.0",
    "js-yaml": "^4.3.0",
    "katex": "^0.17.0",
    "mathjs": "^15.2.0",
    "mathlive": "^0.110.0",
    "mermaid": "^11.16.0",
    "node-cron": "^4.6.0",
    "pitchy": "^4.1.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-markdown": "^10.1.0",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/d3-drag": "^3.0.7",
    "@types/d3-force": "^3.0.10",
    "@types/d3-selection": "^3.0.11",
    "@types/d3-zoom": "^3.0.8",
    "@types/html-to-text": "^9.0.4",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "electron": "^40.10.6",
    "electron-builder": "^26.15.3",
    "jsdom": "^29.1.1",
    "tsx": "^4.23.0",
    "typescript": "^7.0.2",
    "vite": "^8.1.4",
    "vitest": "^4.1.10"
  },
  "build": {
    "appId": "dev.myelin.app",
    "productName": "Engram",
    "files": [
      "dist/**",
      "dist-server/**",
      "electron/**",
      "package.json"
    ],
    "directories": {
      "output": "release"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Education",
      "executableName": "myelin",
      "syncDesktopName": true
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.education"
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "publish": null,
    "asarUnpack": [
      "**/*.md"
    ],
    "afterPack": "electron/afterPack.mjs"
  },
  "desktopName": "myelin.desktop"
}
